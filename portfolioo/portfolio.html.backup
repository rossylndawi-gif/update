  <!-- Scripts -->
  <script src="script.js"></script>

  <script>
    // ============================================
    // CATEGORY FILTERING LOGIC & URL SYNC
    // ============================================
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.work-card');

      function filterCategory(targetCat) {
        // Update active tab button
        filterBtns.forEach(btn => {
          btn.classList.toggle('active', btn.dataset.category === targetCat);
        });

        // Show/hide cards
        cards.forEach(card => {
          const cardCat = card.dataset.category;
          if (targetCat === 'all' || cardCat === targetCat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      // Check URL query param (e.g. ?category=cover)
      const urlParams = new URLSearchParams(window.location.search);
      const categoryParam = urlParams.get('category') || 'videos';
      filterCategory(categoryParam);

      // Add click listeners to filter buttons
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.category;
          filterCategory(cat);
          const newUrl = new URL(window.location);
          newUrl.searchParams.set('category', cat);
          window.history.replaceState({}, '', newUrl);
        });
      });
    });
  </script>
</body>

