/* ========================================== */
/* ROOT VARIABLES - DEEP BLACK & DARK SHADER BLUE THEME */
/* ========================================== */
:root {
  /* Tonal Foundation (True Deep Black & Obsidian) */
  --black: #030407;
  --surface-base: #030407;
  --surface-1: #070a10;
  --surface-2: #0c101a;
  --surface-3: #121826;

  /* Typography Colors */
  --white: #ffffff;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;

  /* Dark Shader Blue Accent System */
  --accent: #1d4ed8;               /* Deep cobalt / royal blue */
  --accent-light: #60a5fa;         /* Luminous shader blue for readable accents & glows */
  --accent-cyan: #38bdf8;          /* Bright highlight */
  --accent-dark: #1e3a8a;          /* Dark navy shader tone */
  --accent-glow: rgba(29, 78, 216, 0.35);
  --tonal-container: rgba(29, 78, 216, 0.2);
  --tonal-outline: rgba(59, 130, 246, 0.38);
  --tonal-hover: rgba(29, 78, 216, 0.32);

  /* Modern Glass Surfaces (Dark Translucent Black with subtle blue depth) */
  --glass: rgba(8, 11, 18, 0.78);
  --glass-bg: rgba(8, 11, 18, 0.78);
  --glass-light: rgba(255, 255, 255, 0.04);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
  --glass-shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.7);
  --glass-blur: 16px;
  --border: rgba(255, 255, 255, 0.08);

  /* Material Radii */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-xl: 24px;
  --radius-full: 9999px;
}

/* ========================================== */
/* GLOBAL STYLES */
/* ========================================== */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--surface-base);
  color: var(--text-primary);
  font-family: 'Google Sans', 'Roboto', 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  position: relative;
  min-height: 100vh;
}

/* ========================================== */
/* FULL-PAGE STARRY BACKGROUND */
/* ========================================== */
body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    radial-gradient(1px 1px at 5% 10%, #ffffff, transparent),
    radial-gradient(1px 1px at 15% 30%, #ffffff, transparent),
    radial-gradient(1px 1px at 25% 50%, #ffffff, transparent),
    radial-gradient(1px 1px at 35% 70%, #ffffff, transparent),
    radial-gradient(1px 1px at 45% 90%, #ffffff, transparent),
    radial-gradient(1px 1px at 55% 15%, #ffffff, transparent),
    radial-gradient(1px 1px at 65% 35%, #ffffff, transparent),
    radial-gradient(1px 1px at 75% 55%, #ffffff, transparent),
    radial-gradient(1px 1px at 85% 75%, #ffffff, transparent),
    radial-gradient(1px 1px at 95% 95%, #ffffff, transparent),
    radial-gradient(1.5px 1.5px at 10% 45%, #dbeafe, transparent),
    radial-gradient(1.5px 1.5px at 30% 80%, #dbeafe, transparent),
    radial-gradient(1.5px 1.5px at 50% 25%, #dbeafe, transparent),
    radial-gradient(1.5px 1.5px at 70% 65%, #dbeafe, transparent),
    radial-gradient(1.5px 1.5px at 90% 40%, #dbeafe, transparent),
    radial-gradient(2px 2px at 20% 60%, #bfdbfe, transparent),
    radial-gradient(2px 2px at 60% 80%, #bfdbfe, transparent),
    radial-gradient(2px 2px at 80% 20%, #bfdbfe, transparent),
    radial-gradient(1px 1px at 12% 88%, #ffffff, transparent),
    radial-gradient(1px 1px at 38% 12%, #ffffff, transparent),
    radial-gradient(1px 1px at 62% 42%, #ffffff, transparent),
    radial-gradient(1px 1px at 88% 68%, #ffffff, transparent),
    radial-gradient(1.2px 1.2px at 5% 55%, #cffafe, transparent),
    radial-gradient(1.2px 1.2px at 42% 95%, #cffafe, transparent),
    radial-gradient(1.2px 1.2px at 78% 5%, #cffafe, transparent),
    radial-gradient(1px 1px at 18% 18%, #ffffff, transparent),
    radial-gradient(1px 1px at 48% 48%, #ffffff, transparent),
    radial-gradient(1px 1px at 72% 72%, #ffffff, transparent),
    radial-gradient(1px 1px at 92% 52%, #ffffff, transparent),
    radial-gradient(1.8px 1.8px at 28% 38%, #93c5fd, transparent),
    radial-gradient(1.8px 1.8px at 68% 58%, #93c5fd, transparent),
    radial-gradient(1px 1px at 8% 72%, #ffffff, transparent),
    radial-gradient(1px 1px at 52% 8%, #ffffff, transparent),
    radial-gradient(1px 1px at 98% 32%, #ffffff, transparent),
    radial-gradient(1px 1px at 3% 92%, #ffffff, transparent),
    radial-gradient(1px 1px at 97% 88%, #ffffff, transparent),
    radial-gradient(1px 1px at 44% 44%, #ffffff, transparent);
  background-repeat: repeat;
  background-size: 100% 100%;
  opacity: 0.35;
  animation: twinkle 5s ease-in-out infinite alternate;
}

/* Twinkling animation */
@keyframes twinkle {
  0% {
    opacity: 0.2;
  }

  50% {
    opacity: 0.45;
  }

  100% {
    opacity: 0.25;
  }
}

/* Ensure all content is above the stars */
header,
main,
footer,
section,
.hero-container,
.hero-content,
#starfield {
  position: relative;
  z-index: 1;
}

/* Canvas starfield - sits above CSS stars */
#starfield {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  background-color: transparent;
}

/* ========================================== */
/* BACKGROUND GRADIENTS (Dark Blue Shader Ambiance on Black) */
/* ========================================== */
body::after {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    radial-gradient(circle at 18% 15%, rgba(29, 78, 216, 0.14) 0%, transparent 55%),
    radial-gradient(circle at 82% 65%, rgba(30, 58, 138, 0.16) 0%, transparent 50%),
    radial-gradient(circle at 50% 95%, rgba(29, 78, 216, 0.12) 0%, transparent 55%);
  background-attachment: fixed;
}

/* ========================================== */
/* PRELOADER */
/* ========================================== */
#preloader {
  position: fixed;
  inset: 0;
  background: var(--surface-base);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.6s ease;
}

.loader-circle {
  width: 52px;
  height: 52px;
  border: 2px solid var(--border);
  border-top: 2px solid var(--accent-light);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ========================================== */
/* HEADER & NAV - MATERIAL GLASS SURFACES */
/* ========================================== */
header {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 50;
  height: 60px;
  width: 90%;
  max-width: 1100px;
  background: rgba(7, 10, 16, 0.82);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 clamp(1.2rem, 3vw, 2.5rem);
  transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

header:hover {
  background: rgba(7, 10, 16, 0.92);
  border-color: rgba(59, 130, 246, 0.25);
  box-shadow: 0 6px 28px rgba(0, 0, 0, 0.65), 0 0 20px rgba(29, 78, 216, 0.15);
}

.logo-txt {
  font-weight: 600;
  font-size: 1.15rem;
  letter-spacing: -0.01em;
  text-transform: lowercase;
  color: var(--text-primary);
  text-decoration: none;
}

.logo-txt span {
  color: var(--accent-light);
}

nav a {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0;
  color: var(--text-muted);
  text-decoration: none;
  margin-left: 0.75rem;
  padding: 0.4rem 0.85rem;
  border-radius: var(--radius-full);
  transition: all 0.2s ease;
  text-transform: lowercase;
}

nav a:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.04);
}

/* Back button in nav */
.back-btn {
  font-size: 0.82rem;
  font-weight: 500;
  letter-spacing: 0;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.2s ease;
  text-transform: lowercase;
  padding: 0.4rem 1.1rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(12px);
  margin-left: 1.5rem;
}

.back-btn:hover {
  color: var(--text-primary);
  border-color: rgba(59, 130, 246, 0.4);
  background: rgba(29, 78, 216, 0.15);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
}

/* ========================================== */
/* MOBILE NAV */
/* ========================================== */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  z-index: 100;
}

.hamburger span {
  width: 24px;
  height: 2px;
  background: var(--text-primary);
  border-radius: 2px;
  transition: 0.3s;
}

.mobile-nav {
  position: fixed;
  inset: 0;
  background: rgba(4, 5, 8, 0.96);
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.8rem;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.mobile-nav.open {
  opacity: 1;
  pointer-events: auto;
}

.mobile-nav a {
  font-size: 1.35rem;
  font-weight: 500;
  letter-spacing: -0.01em;
  color: var(--text-secondary);
  text-decoration: none;
  text-transform: lowercase;
  padding: 0.5rem 1.5rem;
  border-radius: var(--radius-full);
  transition: color 0.2s ease, background 0.2s ease;
}

.mobile-nav a:hover {
  color: var(--accent-light);
  background: var(--tonal-container);
}

.hamburger.open span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.hamburger.open span:nth-child(2) {
  opacity: 0;
}

.hamburger.open span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* ========================================== */
/* HERO - 3D Interactive */
/* ========================================== */
.hero {
  padding: 0;
  height: auto;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.hero-container {
  position: relative;
  height: 100vh;
  width: 100vw;
  display: flex;
  justify-content: center;
  align-items: center;
  perspective: 1000px;
  overflow: hidden;
}

/* Remove hero-specific stars (using global) */
.hero-container .stars {
  display: none;
}

.hero-content {
  position: relative;
  z-index: 10;
  text-align: center;
  color: var(--text-primary);
  transform-style: preserve-3d;
  transition: transform 0.1s ease-out;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  max-width: 860px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.hero-logo-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin: 0 auto 1.8rem auto;
}

/* Logo with 3D tilt and modern ambient shadow */
.hero-logo {
  width: 240px;
  max-width: 65vw;
  height: auto;
  margin: 0 auto;
  display: block;
  filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 25px rgba(29, 78, 216, 0.3));
  transform: rotateX(3deg) rotateY(-3deg);
  transition: transform 0.35s ease, filter 0.35s ease;
}

.hero-logo:hover {
  transform: scale(1.03) rotateX(0deg) rotateY(0deg);
  filter: drop-shadow(0 14px 30px rgba(0, 0, 0, 0.8)) drop-shadow(0 0 35px rgba(37, 99, 235, 0.45));
}

.hero-content .title {
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 600;
  letter-spacing: -0.015em;
  margin-bottom: 16px;
  text-align: center;
  line-height: 1.2;
  color: var(--text-primary);
}

.hero-content .highlight {
  color: var(--accent-light);
  font-weight: 600;
}

.hero-content .subtitle {
  font-size: 1.05rem;
  color: var(--text-muted);
  letter-spacing: 0;
  margin-bottom: 32px;
  text-align: center;
  font-weight: 400;
}

/* Buttons - Material Filled & Tonal Outline */
.btn {
  padding: 11px 26px;
  border-radius: var(--radius-full);
  text-decoration: none;
  font-size: 0.88rem;
  font-weight: 500;
  letter-spacing: 0.01em;
  margin: 0 6px;
  transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  display: inline-block;
}

.btn-outline {
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.btn-filled {
  background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 100%);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 4px 18px rgba(29, 78, 216, 0.45);
}

.btn-outline:hover {
  background: rgba(29, 78, 216, 0.18);
  border-color: rgba(59, 130, 246, 0.45);
  color: var(--text-primary);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.btn-filled:hover {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: 0 6px 24px rgba(37, 99, 235, 0.55);
  transform: translateY(-2px);
}

/* ========================================== */
/* SECTION STYLING */
/* ========================================== */
section {
  padding: clamp(4rem, 7vw, 7rem) clamp(1.5rem, 5vw, 6rem);
  position: relative;
  z-index: 1;
}

.section-title {
  font-family: inherit;
  font-weight: 600;
  letter-spacing: -0.015em;
  font-size: clamp(2rem, 5vw, 3rem);
  text-align: center;
  margin-bottom: 3rem;
  color: var(--text-primary);
  text-transform: lowercase;
}

/* ========================================== */
/* SCROLL REVEAL */
/* ========================================== */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.reveal.active {
  opacity: 1;
  transform: translateY(0);
}

/* Staggered reveal for grid items */
.port-grid .reveal {
  transition-delay: calc(var(--i) * 0.08s);
}

/* ========================================== */
/* HOVER & INTERACTION */
/* ========================================== */
.hover-scale {
  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.hover-scale:hover {
  transform: scale(1.02);
}

.glass-btn {
  display: inline-block;
  padding: 0.75rem 2rem;
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.28) 0%, rgba(30, 58, 138, 0.38) 100%);
  border: 1px solid rgba(59, 130, 246, 0.4);
  border-radius: var(--radius-full);
  color: #93c5fd;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0;
  text-transform: lowercase;
  margin-top: 1.8rem;
  transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  width: fit-content;
  cursor: pointer;
}

.glass-btn:hover {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.45) 0%, rgba(29, 78, 216, 0.55) 100%);
  border-color: #60a5fa;
  color: #ffffff;
  box-shadow: 0 4px 18px rgba(29, 78, 216, 0.45);
  transform: translateY(-2px);
}

/* ========================================== */
/* SERVICES GRID - MATERIAL DARK GLASS CARDS */
/* ========================================== */
.svc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.8rem;
  max-width: 1150px;
  margin: 0 auto;
}

.svc-item {
  text-align: left;
  background: rgba(8, 11, 18, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
  padding: clamp(2rem, 3.5vw, 2.6rem) 2rem;
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
}

.svc-item:hover {
  transform: translateY(-4px);
  border-color: rgba(59, 130, 246, 0.4);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.7), 0 0 20px rgba(29, 78, 216, 0.2);
}

.svc-item h3 {
  font-weight: 600;
  font-size: 1.35rem;
  letter-spacing: -0.01em;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
  text-transform: lowercase;
}

.svc-item p {
  font-weight: 400;
  font-size: 0.92rem;
  line-height: 1.65;
  color: var(--text-secondary);
}

/* ========================================== */
/* PORTFOLIO */
/* ========================================== */
.port-row {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 2rem;
  align-items: center;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 2rem;
}

.port-row:last-child {
  border-bottom: none;
}

.port-label {
  font-weight: 500;
  text-align: right;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.port-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
}

.img-skeleton {
  aspect-ratio: 1/1;
  background: rgba(8, 11, 18, 0.78);
  position: relative;
  cursor: pointer;
  overflow: hidden;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.25s ease, box-shadow 0.25s ease;
}

.img-skeleton:hover {
  transform: translateY(-4px);
  border-color: rgba(59, 130, 246, 0.45);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.65), 0 0 20px rgba(29, 78, 216, 0.25);
}

.img-skeleton img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.img-skeleton:hover img {
  transform: scale(1.05);
}

.img-skeleton:hover .overlay {
  opacity: 1;
}

/* Cover art square aspect ratio */
.work-card.cover-art .thumb-wrapper {
  aspect-ratio: 1/1;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(14, 30, 64, 0.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: 0.25s ease;
  z-index: 1;
}

.overlay span {
  font-weight: 500;
  letter-spacing: 0.01em;
  font-size: 0.85rem;
  color: #ffffff;
  background: rgba(5, 7, 12, 0.75);
  padding: 0.4rem 0.95rem;
  border-radius: var(--radius-full);
  border: 1px solid rgba(59, 130, 246, 0.35);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
}

/* Portfolio Captions */
.port-caption {
  position: absolute;
  bottom: 10px;
  left: 10px;
  right: 10px;
  text-align: center;
  opacity: 0;
  transition: 0.25s ease;
  transform: translateY(8px);
  z-index: 2;
  pointer-events: none;
}

.img-skeleton:hover .port-caption {
  opacity: 1;
  transform: translateY(0);
}

.port-caption h4 {
  font-size: 0.88rem;
  font-weight: 500;
  letter-spacing: 0;
  margin: 0;
  color: var(--text-primary);
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
}

.port-caption p {
  font-size: 0.74rem;
  font-weight: 400;
  color: var(--text-secondary);
  margin: 0;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
}

/* ========================================== */
/* THEY TRUSTED ME SECTION */
/* ========================================== */
.trusted-section {
  position: relative;
  background: transparent;
  padding: clamp(4rem, 7vw, 6rem) 0;
  overflow: hidden;
  z-index: 1;
}

.trusted-header {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.trusted-title {
  margin-bottom: 2.8rem;
  font-family: inherit;
  font-size: clamp(2rem, 5vw, 2.8rem);
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: -0.01em;
  text-align: center;
  line-height: 1.25;
}

.trusted-title .purple-italic {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-weight: 500;
  color: var(--accent-light);
  letter-spacing: normal;
  padding-left: 0.15em;
}

/* Infinite Horizontal Carousel */
.carousel-wrapper {
  position: relative;
  z-index: 2;
  width: 100%;
  overflow: hidden;
  padding: 1rem 0 2rem 0;
  mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 1) 10%, rgba(0, 0, 0, 1) 90%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 1) 10%, rgba(0, 0, 0, 1) 90%, transparent 100%);
}

.carousel-track {
  display: flex;
  width: max-content;
  gap: 3.5rem;
  animation: scrollInfinite 28s linear infinite;
  will-change: transform;
}

.carousel-wrapper:hover .carousel-track {
  animation-play-state: paused;
}

@keyframes scrollInfinite {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(-50%);
  }
}

/* Carousel Client Items */
.client-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-width: 140px;
  user-select: none;
  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.client-item:hover {
  transform: translateY(-4px);
}

/* Circular avatar with Material subtle ring & dark glass interior */
.client-avatar-ring {
  position: relative;
  width: 104px;
  height: 104px;
  border-radius: 50%;
  padding: 0;
  background: rgba(8, 11, 18, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1.5px solid rgba(59, 130, 246, 0.35);
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.55);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.client-item:hover .client-avatar-ring {
  transform: scale(1.04);
  border-color: #3b82f6;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.7), 0 0 18px rgba(29, 78, 216, 0.35);
}

.avatar-placeholder-icon {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(8, 11, 18, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.client-avatar-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  z-index: 2;
  display: block;
}

.client-avatar-img:not([src]),
.client-avatar-img[src=""] {
  display: none;
}

.client-info {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}

.client-name {
  font-family: inherit;
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0;
  white-space: nowrap;
  transition: color 0.2s ease;
}

.client-item:hover .client-name {
  color: var(--accent-light);
}

.client-role {
  font-family: inherit;
  font-size: 0.82rem;
  font-style: normal;
  color: var(--text-muted);
  font-weight: 400;
  letter-spacing: 0;
  white-space: nowrap;
}

/* Responsive */
@media (max-width: 768px) {
  .carousel-track {
    gap: 2.5rem;
  }

  .client-avatar-ring {
    width: 92px;
    height: 92px;
  }

  .client-name {
    font-size: 0.88rem;
  }

  .client-role {
    font-size: 0.8rem;
  }
}

/* ========================================== */
/* MATERIAL DARK GLASS FOOTER */
/* ========================================== */
.purple-footer {
  position: relative;
  background: rgba(5, 7, 12, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: var(--text-primary);
  padding: clamp(3.5rem, 6vw, 5rem) 1.5rem 2.5rem 1.5rem;
  text-align: center;
  overflow: hidden;
  z-index: 10;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.55);
}

.footer-inner {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.footer-email {
  font-family: inherit;
  font-size: clamp(1rem, 2.2vw, 1.25rem);
  font-weight: 500;
  color: var(--text-primary);
  text-decoration: none;
  letter-spacing: 0;
  margin-bottom: 1.8rem;
  transition: transform 0.2s ease, color 0.2s ease;
  display: inline-block;
}

.footer-email:hover {
  transform: translateY(-2px);
  color: var(--accent-light);
}

.footer-socials {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(1.2rem, 3vw, 2rem);
  margin-bottom: 2.8rem;
  flex-wrap: wrap;
}

.footer-socials a {
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.2s ease;
}

.footer-socials a:hover {
  transform: translateY(-2px) scale(1.08);
  color: var(--accent-light);
}

.footer-signature {
  font-family: 'Pinyon Script', cursive;
  font-size: clamp(4rem, 12vw, 7.5rem);
  line-height: 0.95;
  color: var(--text-primary);
  user-select: none;
  margin-bottom: 1.8rem;
  letter-spacing: 0;
  text-align: center;
  pointer-events: none;
}

.footer-copy {
  font-family: inherit;
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 1.5px;
  color: var(--text-muted);
  text-transform: uppercase;
}

/* ========================================== */
/* ABOUT */
/* ========================================== */
.about-container {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  max-width: 1050px;
  margin: 0 auto;
  background: rgba(8, 11, 18, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-xl);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
  overflow: hidden;
}

.about-img {
  width: 100%;
  aspect-ratio: 1/1;
  background: #06080e;
  overflow: hidden;
}

.about-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.about-img:hover img {
  transform: scale(1.03);
}

.about-content {
  padding: 2.8rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.about-content p {
  font-weight: 400;
  line-height: 1.7;
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* ========================================== */
/* CONTACT FORM */
/* ========================================== */
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  max-width: 520px;
  margin: 2rem auto 0;
  padding: 2.2rem;
  background: rgba(8, 11, 18, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-xl);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 1rem 1.15rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.92rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: var(--text-muted);
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: none;
  border-color: #3b82f6;
  background: rgba(29, 78, 216, 0.08);
  box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.25);
}

/* ========================================== */
/* FOOTER FALLBACK */
/* ========================================== */
footer {
  background: rgba(5, 7, 12, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: var(--text-primary);
  padding: 4rem 2rem 2rem;
  text-align: center;
  position: relative;
  z-index: 1;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-brand {
  font-family: 'Pinyon Script', cursive;
  font-size: clamp(3.5rem, 13vw, 10rem);
  line-height: 0.85;
  margin-bottom: 2.5rem;
  color: var(--text-primary);
}

.footer-links a {
  color: var(--text-secondary);
  margin: 0 0.85rem;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
  transition: 0.2s ease;
}

.footer-links a:hover {
  color: var(--accent-light);
}

/* ========================================== */
/* VIDEO MODAL */
/* ========================================== */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(3, 4, 7, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.modal.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 90%;
  max-width: 860px;
  aspect-ratio: 16/9;
  background: #070a10;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(59, 130, 246, 0.2);
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.8), 0 0 30px rgba(29, 78, 216, 0.2);
  position: relative;
  overflow: hidden;
}

.modal-content iframe {
  width: 100%;
  height: 100%;
  border: none;
}

.close-modal {
  position: absolute;
  top: -42px;
  right: 0;
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 2.2rem;
  line-height: 1;
  opacity: 0.8;
  transition: 0.2s ease;
}

.close-modal:hover {
  opacity: 1;
  color: var(--text-primary);
  transform: rotate(90deg);
}

/* Cover Modal */
#cover-modal .modal-content {
  background: transparent;
  box-shadow: none;
  max-width: 580px;
  width: 90%;
  aspect-ratio: auto;
  border: none;
}

#cover-modal img {
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
}

#cover-modal .close-modal {
  font-size: 2.2rem;
  color: var(--text-secondary);
  opacity: 0.8;
  transition: opacity 0.2s ease, color 0.2s ease;
}

#cover-modal .close-modal:hover {
  opacity: 1;
  color: var(--text-primary);
}

/* ========================================== */
/* PURPLE TEXT UTILITY */
/* ========================================== */
.purple-text {
  color: var(--accent-light);
}

/* ========================================== */
/* MEDIA QUERIES */
/* ========================================== */
@media (max-width: 1024px) {
  .works-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }
}

@media (max-width: 768px) {
  .port-row {
    grid-template-columns: 1fr;
  }

  .port-label {
    text-align: left;
  }

  .port-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-container {
    grid-template-columns: 1fr;
  }

  .booking-grid {
    grid-template-columns: 1fr;
    gap: 1.8rem;
  }

  .booking-card {
    padding: 2.5rem 1.5rem 2rem;
  }

  .booking-intro {
    font-size: 0.95rem;
    margin-bottom: 2.5rem;
  }

  nav {
    display: none;
  }

  .hamburger {
    display: flex;
  }

  .back-btn {
    display: none;
  }

  /* Header mobile */
  header {
    top: 12px;
    width: 94%;
    height: 56px;
    border-radius: 12px;
    padding: 0 1rem;
  }

  /* Hero mobile */
  .hero-logo {
    width: 200px;
  }

  .hero-content .title {
    font-size: 2rem;
  }

  .hero-content .subtitle {
    font-size: 1rem;
  }

  .btn {
    padding: 10px 18px;
    font-size: 0.85rem;
    margin: 0 5px;
  }

  /* Cover modal mobile */
  #cover-modal .modal-content {
    width: 95%;
  }

  .close-modal,
  #cover-modal .close-modal {
    top: -42px;
    right: 4px;
    font-size: 2.2rem;
  }

  .works-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .filter-bar {
    gap: 0.4rem;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    font-size: 0.78rem;
  }
}

@media (max-width: 480px) {
  .hero-logo {
    width: 170px;
  }

  .hero-content .title {
    font-size: 1.5rem;
  }

  .btn {
    padding: 8px 14px;
    font-size: 0.75rem;
    margin: 0 3px;
  }

  .port-grid {
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
}

/* ========================================== */
/* PREFERS REDUCED MOTION */
/* ========================================== */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  .hero-container .hero-content {
    transform: none !important;
    transition: none !important;
  }

  body::before {
    animation: none !important;
    opacity: 0.4 !important;
  }
}